# 复制为 .env 后填写（.env 已被 .gitignore 排除），也可以直接设置同名环境变量。只有 ARK_API_KEY 是必填项。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 ID（需先在火山方舟控制台“开通管理”里开通对应模型；也可以填推理接入点 ep-xxxx）
LLM_MODEL=doubao-seed-1-6-250615
IMAGE_MODEL=doubao-seedream-5-0-260128
VIDEO_MODEL=doubao-seedance-2-0-260128
# 草稿阶段省钱：VIDEO_MODEL=doubao-seedance-2-0-fast-260128

VIDEO_RATIO=16:9
VIDEO_RESOLUTION=720p
VIDEO_CONCURRENCY=3
VIDEO_RETRIES=2
# tts=对白用 TTS 配音（音色统一）；native=Seedance 直接生成口型和人声
DIALOGUE_MODE=tts

TTS_ENGINE=edge
NARRATOR_VOICE=zh-CN-YunyangNeural

OUT_W=1280
OUT_H=720
AMBIENT_VOLUME=0.35
# BGM_PATH=assets/bgm.mp3
BGM_VOLUME=0.12
SUB_FONT=Microsoft YaHei
SUB_FONTSIZE=18
# 成片右上角的 AI 生成标识（每日短视频默认加“AI生成”）
# AIGC_LABEL=AI生成

# ---------- 每日热点短视频（daily_run.py） ----------
DAILY_STORY_CHARS=280
DAILY_MAX_SECONDS=60
DAILY_RATIO=9:16
# 1 = 生成分镜和定妆图后暂停，人工确认再出视频（建议前几天开着）
DAILY_REVIEW=1
